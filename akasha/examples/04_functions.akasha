--- Functions in Akasha ---

-- Basic function
karyam namaste() {
    cheppu("Namaste! Ela unnaru?")
}

namaste()

-- Function with parameters and return value
karyam kalupu(a: Sankhya, b: Sankhya): Sankhya {
    phalitham a + b
}

viluva result = kalupu(10, 32)
cheppu(f"10 + 32 = {result}")

-- Default parameters
karyam greet(peru: Padam = "Oka manishi") {
    cheppu(f"Namaste, {peru}!")
}

greet()
greet("Ravi")
greet("Sita")

-- Recursive function — factorial
karyam factorial(n: Sankhya): Sankhya {
    okavela n <= 1 {
        phalitham 1
    }
    phalitham n * factorial(n - 1)
}

cheppu(f"5! = {factorial(5)}")
cheppu(f"10! = {factorial(10)}")

-- Fibonacci
karyam fib(n: Sankhya): Sankhya {
    okavela n <= 1 {
        phalitham n
    }
    phalitham fib(n - 1) + fib(n - 2)
}

cheppu("Fibonacci sequence:")
prathi i lo 0..10 {
    cheppu(f"  fib({i}) = {fib(i)}")
}

-- Higher-order function
karyam apply(fn, value) {
    phalitham fn(value)
}

karyam double(x) {
    phalitham x * 2
}

cheppu(f"apply(double, 21) = {apply(double, 21)}")

-- Closures
viluva multiply_by_3 = muppu(x) => x * 3
cheppu(f"multiply_by_3(7) = {multiply_by_3(7)}")

-- Closure capturing outer variable
karyam make_adder(n) {
    phalitham muppu(x) => x + n
}

viluva add5 = make_adder(5)
viluva add10 = make_adder(10)

cheppu(f"add5(20) = {add5(20)}")
cheppu(f"add10(20) = {add10(20)}")
